# Build-time env vars for verifierform-stake.

# Enable the Bet Lookup feature (set to "true").
PUBLIC_BET_LOOKUP_ENABLED=

# Base URL of the bet-lookup API as seen from the browser.
# For local dev with the mock API: http://localhost:8080
# For production: full URL of the deployed verifierform-stake-bet-lookup instance.
PUBLIC_BET_LOOKUP_URL=
