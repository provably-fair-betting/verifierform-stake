# Local dev env vars for verifierform-stake.

# Base URL of the bet-lookup API written into static/config.json by
# scripts/write-config-json.js (used by dev:lookup and the e2e setup).
# Node does not auto-load .env files, so this must be exported in your
# shell or passed inline — e.g.: BET_LOOKUP_URL=http://localhost:8080 pnpm dev:lookup
# Defaults to http://localhost:8080 when unset (matches pnpm mock:api).
BET_LOOKUP_URL=
