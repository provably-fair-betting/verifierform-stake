{
  "name": "verifierform-stake",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest --ui",
    "test": "npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "sync:paylines": "node scripts/sync-paylines.js",
    "sync:testdata": "node scripts/sync-testdata.js",
    "mock:api": "node scripts/mock-api.js",
    "dev:lookup": "concurrently --kill-others \"node scripts/mock-api.js\" \"node scripts/write-config-json.js && vite dev\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "puppeteer-real-browser": "^1.3.12",
    "rebrowser-puppeteer-core": "^23.10.3",
    "svelte": "^5.37.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "verifierform-stake-payline-extractor": "github:provably-fair-betting/verifierform-stake-payline-extractor#v2.0.0",
    "verifierform-stake-test-data-extractor": "github:provably-fair-betting/verifierform-stake-test-data-extractor#v2.0.0",
    "vite": "^6.3.5",
    "vite-plugin-devtools-json": "^0.3.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer-real-browser",
      "sleep"
    ]
  },
  "dependencies": {
    "@stablelib/hex": "^2.0.1",
    "@stablelib/hmac": "^2.0.1",
    "@stablelib/sha256": "^2.0.1",
    "@stablelib/utf8": "^2.0.1",
    "immutable": "^5.1.3",
    "js-big-decimal": "^2.2.0",
    "tailwind-merge": "^3.3.1",
    "verifierform-core": "github:provably-fair-betting/verifierform-core#v1.1.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
